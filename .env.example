# ==============================================================================
# LIBRA CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env to customize your local settings.
# NEVER commit your actual .env file or real API keys to Git!
# ==============================================================================

# Core System Settings
LIBRA_ENV=development
LIBRA_LEARNING_MODE=true
LIBRA_HOST=127.0.0.1
LIBRA_PORT=8000
LIBRA_LOG_LEVEL=INFO

# Allowed browser origins. JSON list. Empty [] in production when the frontend
# and backend share one origin (single-domain deployment).
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Guest session identity (per-browser conversation isolation)
LIBRA_SESSION_TTL_DAYS=30

# Public-safety gates: keep code execution OFF on shared deployments.
# The notebook/exec endpoint returns 503 while disabled.
LIBRA_PUBLIC_CODE_EXEC=false
# Execution backend when code execution is enabled. Recommended: "jail"
# (isolated subprocess worker with timeouts + resource limits). "inprocess" is
# trusted-operator only. Blank -> refused with the exact mission message.
LIBRA_CODE_SANDBOX=

# Rate limiting (per client IP, token bucket)
LIBRA_RATE_LIMIT_PER_MINUTE=120
LIBRA_RATE_LIMIT_BURST=30

# Hardware & Model Cache Limits
LIBRA_CACHE_DIR=./models
LIBRA_DATA_DIR=./data
MAX_DISK_USAGE_PERCENT=90.0

# Persistence location for conversation/session SQLite store.
# Defaults to $LIBRA_DATA_DIR/conversations.db when unset.
# LIBRA_DB_PATH=./data/conversations.db

# Durable Postgres conversation store (psycopg3). When set, conversations use
# Postgres and fall back to SQLite with a warning only on connection failure.
# DATABASE_URL=postgresql://user:password@host:5432/libra

# Object storage (document uploads). Automatic: SUPABASE_URL + a key -> bucket;
# otherwise local disk under LIBRA_DATA_DIR/uploads. "memory" forces the
# in-process stash (tests only).
# LIBRA_STORAGE_BACKEND=
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=libra-files

# Optional Supabase Auth / JWT sessions (layered over guests; off by default)
# LIBRA_SUPABASE_AUTH_ENABLED=false
# SUPABASE_JWT_SECRET=
# SUPABASE_JWT_AUDIENCE=authenticated

# Optional Model Providers (100% optional, Libra works for $0 out of the box)
# Leave these blank if you do not have or do not want to use paid APIs.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
NVIDIA_API_KEY=
NVIDIA_DEEPSEEK_API_KEY=
NVIDIA_KIMI_API_KEY=
KIMI_API_KEY=
MOONSHOT_API_KEY=

# Local Model Runtimes
OLLAMA_BASE_URL=http://localhost:11434
VLLM_BASE_URL=http://localhost:8000

# --- Frontend (apps/frontend/.env.local) --------------------------------
# Base URL the browser uses to reach the backend API.
# Default (recommended): leave unset -> SAME origin. next.config.mjs + vercel.json
# rewrite /api/* to the backend, so no CORS and no cross-origin leaks.
# Only set this to point a standalone build at an absolute backend URL.
# NEXT_PUBLIC_API_URL=
